# ============================================================
# BACKEND - Variables d'environnement
# ============================================================

# Serveur
NODE_ENV=production
PORT=10000

# Base de données (MongoDB Atlas recommandé)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/campab

# JWT (pour l'authentification admin)
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRES_IN=7d

# Admin par défaut
ADMIN_EMAIL=p.abodecabinet@gmail.com
ADMIN_PASSWORD=mot_de_passe_admin_a_changer

# Cloudinary (pour les uploads d'images)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# CORS - Frontend autorisé
FRONTEND_URL=https://cam-pab.com

# Email (Nodemailer)
EMAIL_USER=p.abodecabinet@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx